# Dosya Yolu: /tools/docker/.env.example
# Amac: OFBiz Docker Compose calisma degiskenleri icin guvenli ornek ortam dosyasi saglar
# Config - ENV
# Version: 2.0.0
# Aciklama: Resmi 24.09.07 image, loopback HTTPS bind ve entrypoint ayarlarini tanimlar
#
# Bagimli Oldugu Katman: Config

OFBIZ_IMAGE=ghcr.io/apache/ofbiz:24.09.07
OFBIZ_CONTAINER_NAME=ofbiz
OFBIZ_HTTPS_BIND=127.0.0.1
OFBIZ_HTTPS_PORT=8443
OFBIZ_DATA_LOAD=seed
OFBIZ_ADMIN_USER=admin
OFBIZ_ADMIN_PASSWORD=CHANGE_ME
OFBIZ_HOST=localhost
