# Dosya Yolu: /tools/docker/Dockerfile.compat
# Amac: Resmi Dockerfile bulunmayan eski OFBiz release paketleri icin runtime ve demo image'lari olusturur
# Config - Dockerfile
# Version: 2.0.0
# Aciklama: Java major surumune gore legacy kaynaklari runtime/demo stage'leri ile container image'e cevirir
#
# Bagimli Oldugu Katman: Config | Tool

ARG JAVA_MAJOR=17

FROM eclipse-temurin:${JAVA_MAJOR}-jdk AS base

WORKDIR /ofbiz

COPY . /ofbiz

RUN chmod +x gradlew     && if [ -f gradle/init-gradle-wrapper.sh ]; then bash gradle/init-gradle-wrapper.sh; fi

EXPOSE 8443 8009 5005

FROM base AS runtime

CMD ["./gradlew", "ofbiz"]

FROM base AS demo

RUN ./gradlew --no-daemon loadAll

CMD ["./gradlew", "ofbiz"]
